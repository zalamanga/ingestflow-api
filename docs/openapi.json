    "/v1/records": {
      "get": {
        "tags": [
          "Records"
        ],
        "summary": "Records",
        "description": "Current records sorted by ASCII SKU. Cursor traversal is stable for existing keys; it is not a database snapshot across requests.",
        "operationId": "records_v1_records_get",
        "security": [
          {
            "TenantBearer": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^$|^[A-Z0-9][A-Z0-9_-]{0,31}$",
              "default": "",
              "title": "After"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
